# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this to .env.local for local overrides
#
# Next.js loads env files in this order:
#   1. .env                  (all environments, lowest priority)
#   2. .env.local            (all environments, gitignored)
#   3. .env.development      (dev only, when running `npm run dev`)
#   4. .env.production       (prod only, when running `npm run build` / `npm start`)
#   5. .env.development.local / .env.production.local (gitignored overrides)
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================

# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:5003/api

# Base Path (kosong untuk dev, contoh: /ppc-schedule untuk prod)
NEXT_PUBLIC_BASE_PATH=

# App Name (tampil di title bar)
NEXT_PUBLIC_APP_NAME=PPC Schedule
